prefix=/opt/homebrew/Cellar/gstreamer/1.24.11
datadir=${prefix}/share
includedir=${prefix}/include
libdir=${prefix}/lib
libexecdir=${prefix}/libexec

exec_prefix=${prefix}
toolsdir=${exec_prefix}/bin
pluginsdir=${libdir}/gstreamer-1.0
girdir=${datadir}/gir-1.0
typelibdir=${libdir}/girepository-1.0
pluginscannerdir=${libexecdir}/gstreamer-1.0

Name: gstreamer-video-1.0
Description: Video base classes and helper functions
Version: 1.24.11
Requires: gstreamer-1.0, gstreamer-base-1.0
Requires.private: glib-2.0 >=  2.64.0, gobject-2.0, gmodule-no-export-2.0, orc-0.4 >=  0.4.24
Libs: -L${libdir} -lgstvideo-1.0
Libs.private: -lm
Cflags: -I${includedir}/gstreamer-1.0
