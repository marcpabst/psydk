prefix=/opt/homebrew/Cellar/gstreamer/1.24.11
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gstwebrtchttp
Description: GStreamer WebRTC Plugin for WebRTC HTTP protocols (WHIP/WHEP)
Version: 0.12.11
Libs: -L${libdir}/gstreamer-1.0 -lgstwebrtchttp
Cflags: 
Libs.private: -lgstwebrtc-1.0 -lgstaudio-1.0 -lgstbase-1.0 -lgstreamer-1.0 -lgobject-2.0 -lglib-2.0 -lintl -lgstsdp-1.0 -framework SystemConfiguration Security CoreFoundation -lgio-2.0 -liconv -lSystem -lc -lm
Requires.private: gstreamer-1.0, gstreamer-base-1.0, gobject-2.0, glib-2.0, gstreamer-sdp-1.0, gstreamer-webrtc-1.0
