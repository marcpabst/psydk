prefix=/opt/homebrew/Cellar/gstreamer/1.24.11
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gstregex
Description: GStreamer Regular Expression Plugin
Version: 0.12.11
Libs: -L${libdir}/gstreamer-1.0 -lgstregex
Cflags: 
Libs.private: -lgstreamer-1.0 -lgobject-2.0 -lgio-2.0 -lglib-2.0 -lintl -liconv -lSystem -lc -lm
Requires.private: gstreamer-1.0, gobject-2.0, glib-2.0, gmodule-2.0
