prefix=/opt/homebrew/Cellar/gstreamer/1.24.11
datadir=${prefix}/share
includedir=${prefix}/include
libdir=${prefix}/lib

exec_prefix=${prefix}
toolsdir=${exec_prefix}/bin
pluginsdir=${libdir}/gstreamer-1.0
datarootdir=${prefix}/share
girdir=${datadir}/gir-1.0
typelibdir=${libdir}/girepository-1.0

Name: gstreamer-insertbin-1.0
Description: Bin to automatically and insertally link elements
Version: 1.24.11
Requires: gstreamer-1.0
Requires.private: glib-2.0 >=  2.64.0, gobject-2.0, gmodule-no-export-2.0
Libs: -L${libdir} -lgstinsertbin-1.0
Cflags: -I${includedir}/gstreamer-1.0
