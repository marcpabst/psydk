prefix=/opt/homebrew/Cellar/gstreamer/1.24.11
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gstrsonvif
Description: GStreamer Rust ONVIF Plugin
Version: 0.12.11
Libs: -L${libdir}/gstreamer-1.0 -lgstrsonvif
Cflags: 
Libs.private: -framework CoreFoundation -lpangocairo-1.0 -lpango-1.0 -lcairo -lharfbuzz -lgobject-2.0 -lglib-2.0 -lintl -lcairo-gobject -lgstvideo-1.0 -lgstbase-1.0 -lgstreamer-1.0 -lgstrtp-1.0 -lgio-2.0 -liconv -lSystem -lc -lm
Requires.private: gstreamer-1.0, gstreamer-base-1.0, gobject-2.0, glib-2.0, gmodule-2.0, pango, pangocairo
