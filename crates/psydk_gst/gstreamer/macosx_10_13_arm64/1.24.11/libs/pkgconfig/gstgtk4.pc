prefix=/opt/homebrew/Cellar/gstreamer/1.24.11
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gstgtk4
Description: GStreamer GTK 4 sink element
Version: 0.12.11
Libs: -L${libdir}/gstreamer-1.0 -lgstgtk4
Cflags: 
Libs.private: -lgstgl-1.0 -lgstvideo-1.0 -lgstbase-1.0 -lgstreamer-1.0 -lgobject-2.0 -lglib-2.0 -lintl -lX11 -lxcb -lgtk-4 -lpangocairo-1.0 -lpango-1.0 -lharfbuzz -lgdk_pixbuf-2.0 -lcairo-gobject -lcairo -lgraphene-1.0 -lgio-2.0 -liconv -lSystem -lc -lm
Requires.private: gstreamer-1.0, gstreamer-base-1.0, gstreamer-video-1.0, gtk4, gobject-2.0, glib-2.0, gmodule-2.0
