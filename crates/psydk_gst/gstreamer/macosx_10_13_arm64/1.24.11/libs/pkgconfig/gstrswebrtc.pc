prefix=/opt/homebrew/Cellar/gstreamer/1.24.11
exec_prefix=${prefix}
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gstrswebrtc
Description: GStreamer plugin for high level WebRTC elements and a simple signaling server
Version: 0.12.11
Libs: -L${libdir}/gstreamer-1.0 -lgstrswebrtc
Cflags: 
Libs.private: -lgstaudio-1.0 -lgstbase-1.0 -lgstreamer-1.0 -lgobject-2.0 -lglib-2.0 -lintl -lgstwebrtc-1.0 -lgstsdp-1.0 -lgstvideo-1.0 -lgstapp-1.0 -lgstrtp-1.0 -framework SystemConfiguration Security CoreFoundation -lgio-2.0 -liconv -lSystem -lc -lm
Requires.private: gstreamer-rtp-1.0 >= 1.20, gstreamer-webrtc-1.0 >= 1.20, gstreamer-1.0 >= 1.20, gstreamer-app-1.0 >= 1.20, gstreamer-video-1.0 >= 1.20, gstreamer-sdp-1.0 >= 1.20, gobject-2.0, glib-2.0, gmodule-2.0
